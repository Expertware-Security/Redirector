# ---- Claude Code / agent state ----
# Local agent state and anything potentially sensitive that Claude writes
# locally (memory, transcripts, local settings). Keep settings.json shareable
# if the team wants it; everything else under .claude stays local.
.claude/*
!.claude/settings.json
.claude.json
.claude.json.backup
CLAUDE.local.md

# ---- Secrets / credentials ----
# Never commit anything that looks like a secret. Add to this list if you
# introduce a new format; do not whitelist a single file unless you are sure.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.kdbx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
known_hosts
authorized_keys
secrets.*
credentials.*
*.secret
*.secrets

# ---- Generated by the setup script at runtime ----
# These never belong in the repo; the script regenerates them on the target host.
/etc/ssl/redirector/
redirector.crt
redirector.key

# ---- Test artifacts ----
# The test runner writes logs to /tmp inside the container; nothing should
# land in the repo, but be defensive in case someone redirects output here.
tests/*.log
tests/tmp/
*.log

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
.Trash-*
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ---- Python (used by tests/backend.py) ----
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
env/

# ---- Misc ----
*.bak
*.tmp
*.orig
*.rej
